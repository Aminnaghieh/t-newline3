# Liara SRE Agent Configuration
# Copy this file to .env and fill in your values
#
# NOTE: tokens are BEST stored in the OS keyring via `liara-agent config set-token`.
# This .env file (if used) must live in the app config dir (~/.config/liara-agent/.env)
# and is automatically restricted to owner-only permissions (0600).

# Liara API Token (required)
# Get from: https://console.liara.ir/ → API Tokens
LIARA_API_TOKEN=liara_xxxxxxxxxxxxxxxx

# OpenAI API Key (required for AI features)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# Optional: Override the OpenAI-compatible AI gateway URL
# OPENAI_BASE_URL=https://ai.liara.ir/api/your-project-id/v1

# Optional: Override default Liara API base URL
# LIARA_API_BASE_URL=https://api.liara.ir

# Optional: Default project name
# LIARA_DEFAULT_PROJECT=my-app

# Optional: Liara team ID for team accounts
# LIARA_TEAM_ID=

# ─── Security toggles ────────────────────────────────────────
# MCP server: allow write/destructive tools (restart/scale/resize/deploy).
# Default is OFF — any connected AI client can only perform read operations.
# LIARA_MCP_ALLOW_WRITES=1

# MCP server: filesystem containment root for local project analysis/deploy.
# Paths outside the CWD or this root are refused.
# LIARA_MCP_WORKSPACE_ROOT=~/projects

# Optional: Log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO
