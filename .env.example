# Liara SRE Agent Configuration
# Copy this file to .env and fill in your values

# Liara API Token (required)
# Get from: https://console.liara.ir/ → API Tokens
LIARA_API_TOKEN=liara_xxxxxxxxxxxxxxxx

# OpenAI API Key (required for AI features)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# Optional: Override default Liara API base URL
# LIARA_API_BASE_URL=https://ai.liara.ir/api/v1/

# Optional: Default project name
# LIARA_DEFAULT_PROJECT=my-app

# Optional: Log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO
